INSERT INTO SERVICECOMPONENT VALUES(0,28314,'com.liferay.change.tracking.store.service',1,1571891177226,'<?xml version="1.0"?>\u000a\u000a<data>\u000a\u0009<tables-sql><![CDATA[create table CTSContent (\u000a\u0009mvccVersion LONG default 0 not null,\u000a\u0009ctCollectionId LONG default 0 not null,\u000a\u0009ctsContentId LONG not null,\u000a\u0009companyId LONG,\u000a\u0009repositoryId LONG,\u000a\u0009path_ VARCHAR(75) null,\u000a\u0009version VARCHAR(75) null,\u000a\u0009data_ BLOB,\u000a\u0009size_ LONG,\u000a\u0009storeType VARCHAR(75) null,\u000a\u0009primary key (ctsContentId, ctCollectionId)\u000a);]]></tables-sql>\u000a\u0009<sequences-sql><![CDATA[]]></sequences-sql>\u000a\u0009<indexes-sql><![CDATA[create unique index IX_8948D363 on CTSContent (companyId, repositoryId, storeType[$COLUMN_LENGTH:75$], path_[$COLUMN_LENGTH:75$], version[$COLUMN_LENGTH:75$], ctCollectionId);]]></indexes-sql>\u000a</data>')
