INSERT INTO SERVICECOMPONENT VALUES(0,31303,'com.liferay.data.engine.service',1,1563319018369,'<?xml version="1.0"?>\u000a\u000a<data>\u000a\u0009<tables-sql><![CDATA[create table DEDataDefinitionFieldLink (\u000a\u0009mvccVersion LONG default 0 not null,\u000a\u0009ctCollectionId LONG default 0 not null,\u000a\u0009uuid_ VARCHAR(75) null,\u000a\u0009deDataDefinitionFieldLinkId LONG not null,\u000a\u0009groupId LONG,\u000a\u0009companyId LONG,\u000a\u0009createDate DATE null,\u000a\u0009modifiedDate DATE null,\u000a\u0009classNameId LONG,\u000a\u0009classPK LONG,\u000a\u0009ddmStructureId LONG,\u000a\u0009fieldName VARCHAR(255) null,\u000a\u0009lastPublishDate DATE null,\u000a\u0009primary key (deDataDefinitionFieldLinkId, ctCollectionId)\u000a);\u000a\u000acreate table DEDataListView (\u000a\u0009mvccVersion LONG default 0 not null,\u000a\u0009ctCollectionId LONG default 0 not null,\u000a\u0009uuid_ VARCHAR(75) null,\u000a\u0009deDataListViewId LONG not null,\u000a\u0009groupId LONG,\u000a\u0009companyId LONG,\u000a\u0009userId LONG,\u000a\u0009userName VARCHAR(75) null,\u000a\u0009createDate DATE null,\u000a\u0009modifiedDate DATE null,\u000a\u0009appliedFilters TEXT null,\u000a\u0009ddmStructureId LONG,\u000a\u0009fieldNames TEXT null,\u000a\u0009name STRING null,\u000a\u0009sortField VARCHAR(75) null,\u000a\u0009primary key (deDataListViewId, ctCollectionId)\u000a);]]></tables-sql>\u000a\u0009<sequences-sql><![CDATA[]]></sequences-sql>\u000a\u0009<indexes-sql><![CDATA[create index IX_99628DD1 on DEDataDefinitionFieldLink (classNameId, classPK);\u000acreate unique index IX_B0B67DC9 on DEDataDefinitionFieldLink (ddmStructureId, classNameId, fieldName[$COLUMN_LENGTH:255$], classPK, ctCollectionId);\u000acreate index IX_E931B304 on DEDataDefinitionFieldLink (ddmStructureId, fieldName[$COLUMN_LENGTH:255$]);\u000acreate index IX_255E05B8 on DEDataDefinitionFieldLink (uuid_[$COLUMN_LENGTH:75$]);\u000a\u000acreate index IX_81B6947 on DEDataListView (ddmStructureId, grou