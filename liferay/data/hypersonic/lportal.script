0009\u0009\u0009\u0009\u0009cssClass="btn-unstyled facet-term ${(entry.isSelected())?then(''facet-term-selected'', ''facet-term-unselected'')} term-name"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009data\-term\-id="${entry.getFilterValue()}"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009disabled="true"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009displayType="link"\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009onClick="Liferay.Search.FacetUtil.changeSelection(event);"\u000a\u0009\u0009\u0009\u0009\u0009\u0009>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isSelected()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<strong>${htmlUtil.escape(entry.getBucketText())}</strong>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#else>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009${htmlUtil.escape(entry.getBucketText())}\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009<#if entry.isFrequencyVisible()>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009<small class="term-count">\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009(${entry.getFrequency()})\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009</small>\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009</#if>\u000a\u0009\u0009\u0009\u0009\u0009\u0009</@clay.button>\u000a\u0009\u0009\u0009\u0009\u0009</li>\u000a\u0009\u0009\u0009\u0009</#list>\u000a\u0009\u0009\u0009</#if>\u000a\u0009\u0009</ul>\u000a\u0009</@>\u000a</@>',0,20095,NULL,'2026-06-10 16:19:24.916000')
