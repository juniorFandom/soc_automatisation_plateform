FROM debian:12-slim

# Éviter les interactions pendant l'installation
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Variables d'environnement pour la connexion au Wazuh Manager
# ENV WAZUH_MANAGER_IP=172.25.0.30   
# ENV WAZUH_AUTH_PORT=1515           
# ENV WAZUH_AGENT_PASSWORD=MonPasse   

# Installation des dépendances système
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    openssh-client \
    sshpass \
    curl \
    wget \
    git \
    vim \
    jq \
    iputils-ping \
    net-tools \
    dnsutils \
    sudo \
    systemd \
    gnupg \
    apt-transport-https \
    && rm -rf /var/lib/apt/lists/*

# Ajout de la clé GPG et du dépôt Wazuh
RUN curl -s https://packages.wazuh.com/key/GPG-KEY-WAZUH | gpg --no-default-keyring --keyring gnupg-ring:/usr/share/keyrings/wazuh.gpg --import \
    && chmod 644 /usr/share/keyrings/wazuh.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/wazuh.gpg] https://packages.wazuh.com/4.x/apt/ stable main" | tee /etc/apt/sources.list.d/wazuh.list

# Installation de l'agent Wazuh
RUN apt-get update && apt-get install -y wazuh-agent \
    && rm -rf /var/lib/apt/lists/*

# Copie du certificat de l'autorité (CA) pour vérifier le manager
COPY certificat/root-ca.pem /var/ossec/etc/root-ca.pem

RUN pip3 install --no-cache-dir --break-system-packages \
    ansible==8.0.0 \
    ansible-lint==6.17.0 \
    boto3==1.34.0 \
    botocore==1.34.0 \
    docker==6.1.0 \
    pywinrm==0.4.3 \
    requests==2.31.0

# Création des répertoires de travail
RUN mkdir -p /etc/ansible \
    /ansible/playbooks \
    /ansible/inventory \
    /ansible/scripts \
    /ansible/logs \
    /ansible/collections

# Copie des fichiers de configuration
COPY ansible.cfg /etc/ansible/ansible.cfg
COPY inventory/hosts.ini /ansible/inventory/hosts.ini

# Copie des playbooks
COPY playbooks/*.yml /ansible/playbooks/

# Copie du script d'entrée
COPY entrypoint.sh /entrypoint.sh

# Installation des collections Ansible
RUN ansible-galaxy collection install community.docker \
    && ansible-galaxy collection install community.general \
    && ansible-galaxy collection install ansible.posix

# Permissions d'exécution
RUN chmod +x /entrypoint.sh

# Variables d'environnement pour Ansible
ENV ANSIBLE_HOST_KEY_CHECKING=False
ENV ANSIBLE_STDOUT_CALLBACK=yaml
ENV ANSIBLE_RETRY_FILES_ENABLED=False
ENV ANSIBLE_VERBOSITY=1

# Volume pour les logs
VOLUME ["/ansible/logs"]

# Répertoire de travail
WORKDIR /ansible

# Point d'entrée
ENTRYPOINT ["/entrypoint.sh"]