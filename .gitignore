# Create .gitignore file with proper exclusions
@"
# Large binary files
*.tar.gz
*.tar
*.zip
*.gz
*.rar
*.7z

# Logs
logs/
*.log
*.json

# Database
*.db
*.sqlite
*.sqlite3

# Wazuh specific
wazuh/wazuh-indexer/*.tar.gz
wazuh/wazuh-dashboard/*.tar.gz
wazuh/wazuh-manager/logs/
wazuh/wazuh-manager/queue/db/
wazuh/wazuh-manager/queue/
wazuh/certs/
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
"@ | Out-File -FilePath .gitignore -Encoding utf8